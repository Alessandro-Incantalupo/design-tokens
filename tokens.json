  "roles": [
    {
      "name": "--surface",
      "kind": "color",
      "description": "Page background.",
      "tailwind": [
        "bg-surface"
      ]
    },
    {
      "name": "--surface-raised",
      "kind": "color",
      "description": "Cards, panels, menus and dialogs that sit above the page.",
      "tailwind": [
        "bg-surface-raised"
      ]
    },
    {
      "name": "--surface-sunken",
      "kind": "color",
      "description": "Wells below the page: table headers, code blocks, read-only fields.",
      "tailwind": [
        "bg-surface-sunken"
      ]
    },
    {
      "name": "--text",
      "kind": "color",
      "description": "Body text and headings.",
      "tailwind": [
        "text-default"
      ],
      "contrast": {
        "use": "small text",
        "min": 7,
        "on": [
          "--surface",
          "--surface-raised",
          "--surface-sunken"
        ]
      }
    },
    {
      "name": "--text-muted",
      "kind": "color",
      "description": "Secondary text: captions, help lines, table metadata. Often 12-14 px.",
      "tailwind": [
        "text-muted"
      ],
      "contrast": {
        "use": "small text",
        "min": 7,
        "on": [
          "--surface",
          "--surface-raised",
          "--surface-sunken"
        ]
      }
    },
    {
      "name": "--border",
      "kind": "color",
      "description": "Dividers and card edges. Decorative: nothing depends on seeing it.",
      "tailwind": [
        "border-border",
        "divide-border"
      ]
    },
    {
      "name": "--border-strong",
      "kind": "color",
      "description": "Edges you must see to use a control: inputs, checkboxes, toggles.",
      "tailwind": [
        "border-border-strong"
      ],
      "contrast": {
        "use": "non-text",
        "min": 3,
        "on": [
          "--surface",
          "--surface-raised",
          "--surface-sunken"
        ]
      }
    },
    {
      "name": "--accent",
      "kind": "color",
      "description": "Primary buttons, selected states, active indicators.",
      "tailwind": [
        "bg-accent",
        "border-accent"
      ],
      "contrast": {
        "use": "non-text",
        "min": 3,
        "on": [
          "--surface",
          "--surface-raised",
          "--surface-sunken"
        ]
      }
    },
    {
      "name": "--accent-strong",
      "kind": "color",
      "description": "The accent under the pointer or pressed.",
      "tailwind": [
        "hover:bg-accent-strong"
      ]
    },
    {
      "name": "--on-accent",
      "kind": "color",
      "description": "Text and icons on the accent fill.",
      "tailwind": [
        "text-on-accent"
      ],
      "contrast": {
        "use": "text",
        "min": 4.5,
        "on": [
          "--accent",
          "--accent-strong"
        ]
      }
    },
    {
      "name": "--accent-subtle",
      "kind": "color",
      "description": "A tinted background: a selected row, an active menu item, a chip.",
      "tailwind": [
        "bg-accent-subtle"
      ]
    },
    {
      "name": "--on-accent-subtle",
      "kind": "color",
      "description": "Text on the tinted accent background.",
