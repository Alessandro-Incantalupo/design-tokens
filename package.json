{
  "name": "@a.incantalupo/design-tokens",
  "version": "0.1.0",
  "description": "Framework-free design tokens as plain CSS custom properties: palette, brand accent and roles, light and dark themes, a Tailwind 4 bridge and a JSON export.",
  "keywords": [
    "design-tokens",
    "css",
    "css-variables",
    "custom-properties",
    "theme",
    "dark-mode",
    "tailwindcss",
    "tailwind-v4",
    "wcag",
    "contrast",
    "accessibility"
  ],
  "homepage": "https://github.com/Alessandro-Incantalupo/design-tokens#readme",
  "bugs": {
    "url": "https://github.com/Alessandro-Incantalupo/design-tokens/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alessandro-Incantalupo/design-tokens.git"
  },
  "license": "MIT",
  "author": "Alessandro Incantalupo",
  "type": "module",
  "exports": {
    ".": {
      "style": "./index.css",
      "default": "./index.css"
    },
    "./tokens.css": {
      "style": "./tokens.css",
      "default": "./tokens.css"
    },
    "./themes/*": {
      "style": "./themes/*",
      "default": "./themes/*"
    },
    "./tailwind.css": {
      "style": "./tailwind.css",
      "default": "./tailwind.css"
    },
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "style": "./index.css",
  "files": [
    "index.css",
    "tokens.css",
    "themes/*.css",
    "tailwind.css",
    "tokens.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc",
    "test": "vitest run",
    "contrast": "node scripts/contrast.ts",
    "tokens:build": "node scripts/build-json.ts",
    "tokens:check": "node scripts/build-json.ts --check",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm contrast && pnpm tokens:check",
    "prepublishOnly": "node scripts/build-json.ts --check && node scripts/contrast.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
